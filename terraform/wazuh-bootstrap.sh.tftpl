#!/bin/bash
set -Eeuo pipefail
exec > >(tee -a /var/log/lab-bootstrap.log | logger -t lab-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y ca-certificates curl git docker.io docker-compose-v2 awscli
systemctl enable --now docker

INDEXER_PASSWORD="$(aws ssm get-parameter --name '${indexer_password_parameter}' --with-decryption --query Parameter.Value --output text --region '${aws_region}')"
API_PASSWORD="$(aws ssm get-parameter --name '${api_password_parameter}' --with-decryption --query Parameter.Value --output text --region '${aws_region}')"

# Wazuh's official single-node deployment persists index, manager and dashboard data
# on this encrypted 80 GiB root volume. Keep this directory across instance restarts.
sysctl -w vm.max_map_count=262144
echo 'vm.max_map_count=262144' >/etc/sysctl.d/99-wazuh.conf
install -d -m 0750 /opt/wazuh-docker
git clone --depth 1 --branch v4.12.0 https://github.com/wazuh/wazuh-docker.git /opt/wazuh-docker
cd /opt/wazuh-docker/single-node

cat >.env <<'ENVFILE'
INDEXER_USERNAME=admin
INDEXER_PASSWORD=$INDEXER_PASSWORD
API_USERNAME=wazuh-wui
API_PASSWORD=$API_PASSWORD
ENVFILE
chmod 0600 .env

# Make the unique verifier marker generate a searchable alert in wazuh-alerts-*.
RULES=config/wazuh_cluster/rules/local_rules.xml
if ! grep -q '100100' "$RULES"; then
  cat >>"$RULES" <<'RULE'

<group name="lab,">
  <rule id="100100" level="5">
    <match>lab_marker=</match>
    <description>Lab ingress request marker observed in Docker access logs.</description>
  </rule>
</group>
RULE
fi

docker compose -f generate-indexer-certs.yml run --rm generator
docker compose up -d
echo 'Wazuh bootstrap complete.'