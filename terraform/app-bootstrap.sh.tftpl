#!/bin/bash
set -Eeuo pipefail
exec > >(tee -a /var/log/lab-bootstrap.log | logger -t lab-bootstrap -s 2>/dev/console) 2>&1

export DEBIAN_FRONTEND=noninteractive
# On first boot unattended-upgrades often holds the apt lock; wait instead of failing.
echo 'DPkg::Lock::Timeout "600";' >/etc/apt/apt.conf.d/99lock-timeout
apt-get update
apt-get install -y ca-certificates curl gnupg unzip netcat-openbsd wireguard iptables

# Ubuntu 24.04 has no installable "awscli" apt package, so use the official v2 installer.
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip -o /tmp/awscliv2.zip
  unzip -q -o /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install
fi

SERVER_PRIVATE_KEY="$(aws ssm get-parameter --name '${server_key_parameter}' --with-decryption --query Parameter.Value --output text --region '${aws_region}')"

# VPN routing is private; this gateway is the only public ingress to the lab.
cat >/etc/sysctl.d/99-lab-wireguard.conf <<'SYSCTL'
net.ipv4.ip_forward=1
SYSCTL
sysctl --system
install -d -m 0700 /etc/wireguard
cat >/etc/wireguard/wg0.conf <<WGCONF
[Interface]
Address = 10.77.0.1/24
ListenPort = 51820
PrivateKey = $SERVER_PRIVATE_KEY
PostUp = iptables -A FORWARD -i wg0 -j ACCEPT; iptables -A FORWARD -o wg0 -j ACCEPT; iptables -t nat -A POSTROUTING -s 10.77.0.0/24 -o ens5 -j MASQUERADE
PostDown = iptables -D FORWARD -i wg0 -j ACCEPT; iptables -D FORWARD -o wg0 -j ACCEPT; iptables -t nat -D POSTROUTING -s 10.77.0.0/24 -o ens5 -j MASQUERADE

[Peer]
PublicKey = ${client_public_key}
AllowedIPs = 10.77.0.2/32
WGCONF
chmod 0600 /etc/wireguard/wg0.conf
systemctl enable --now wg-quick@wg0

# Docker is installed from its signed upstream repository.
install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc
echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" >/etc/apt/sources.list.d/docker.list
apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

install -d -m 0755 /opt/juice-lab
cat >/opt/juice-lab/compose.yaml <<'COMPOSE'
services:
  juice-shop:
    image: bkimminich/juice-shop:v17.1.1
    container_name: juice-shop
    restart: unless-stopped
    expose:
      - "3000"
    networks: [lab]
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  waf:
    image: owasp/modsecurity-crs:nginx
    container_name: juice-waf
    restart: unless-stopped
    depends_on: [juice-shop]
    environment:
      BACKEND: http://juice-shop:3000
      PORT: "8080"
      MODSEC_RULE_ENGINE: "On"
      PARANOIA: "1"
      ANOMALY_INBOUND: "5"
    ports:
      - "80:8080"
    volumes:
      - ./REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf:/etc/modsecurity.d/owasp-crs/rules/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf:ro
    networks: [lab]
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  lab:
    name: juice-lab
COMPOSE

# This local rule gives the assignment a deterministic 403 independent of CRS tuning.
cat >/opt/juice-lab/REQUEST-900-EXCLUSION-RULES-BEFORE-CRS.conf <<'WAFRULE'
SecRule ARGS:lab_block "@streq 1" "id:100100,phase:1,deny,status:403,log,msg:'Lab deterministic block rule'"
WAFRULE
# Install and enroll the host agent. The manager's enrollment port is SG-limited to this VM.
# The Wazuh VM boots in parallel, so wait (up to ~30 min) for its enrollment port first.
for _ in $(seq 1 180); do
  nc -z -w 3 '${wazuh_manager_ip}' 1515 && break
  sleep 10
done
curl -fsSL https://packages.wazuh.com/key/GPG-KEY-WAZUH | gpg --dearmor -o /usr/share/keyrings/wazuh.gpg
echo "deb [signed-by=/usr/share/keyrings/wazuh.gpg] https://packages.wazuh.com/4.x/apt/ stable main" >/etc/apt/sources.list.d/wazuh.list
apt-get update
# Pin the agent: Wazuh agents must not be newer than the manager (4.12.0 here).
WAZUH_MANAGER='${wazuh_manager_ip}' WAZUH_AGENT_NAME='juice-waf-host' apt-get install -y 'wazuh-agent=${wazuh_version}-1'

# Collect Docker's JSON log stream, including the WAF's access log request URI.
python3 - <<'PY'
from pathlib import Path
path = Path('/var/ossec/etc/ossec.conf')
text = path.read_text()
entry = '''\n  <localfile>\n    <log_format>json</log_format>\n    <location>/var/lib/docker/containers/*/*.log</location>\n  </localfile>\n'''
if '/var/lib/docker/containers/*/*.log' not in text:
    text = text.replace('</ossec_config>', entry + '</ossec_config>')
    path.write_text(text)
PY
systemctl daemon-reload
systemctl enable --now wazuh-agent
docker compose -f /opt/juice-lab/compose.yaml up -d

echo 'Lab app bootstrap complete.'